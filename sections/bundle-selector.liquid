{%- liquid
  assign bundle_product = section.settings.product | default: settings.hero_product
  assign has_selling_plans = false
  if bundle_product.selling_plan_groups.size > 0 and section.settings.show_subscribe
    assign has_selling_plans = true
  endif
-%}

<div class="section bundle{% if section.settings.show_divider %} section--bordered{% endif %}" id="{{ section.settings.anchor | default: 'bundle' }}">
  <div class="page-width">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if bundle_product == blank -%}
      <p class="text-secondary text-center">
        Choose a featured product in Theme settings &rarr; Product to show bundle pricing.
      </p>
    {%- else -%}
      <span class="glow bundle__glow" aria-hidden="true"></span>
      <bundle-selector class="bundle__wrap">
        {%- if has_selling_plans -%}
          {%- assign plan_group = bundle_product.selling_plan_groups | first -%}
          <div class="bundle__subscribe">
            <label class="bundle__switch" for="BundleSubscribe-{{ section.id }}">
              <input
                class="bundle__switch-input"
                type="checkbox"
                id="BundleSubscribe-{{ section.id }}"
                data-subscribe-toggle
                {% if section.settings.subscribe_default %}
                  checked
                {% endif %}
              >
              <span class="bundle__switch-track" aria-hidden="true"><span class="bundle__switch-thumb"></span></span>
              <span class="bundle__switch-label">
                <span class="bundle__switch-title">
                  {{- section.settings.subscribe_label | default: plan_group.name -}}
                </span>
                {%- if section.settings.subscribe_note != blank -%}
                  <span class="text-small text-secondary">{{ section.settings.subscribe_note }}</span>
                {%- endif -%}
              </span>
            </label>
          </div>
        {%- endif -%}

        <div class="bundle__options" role="radiogroup" aria-label="{{ section.settings.heading | default: 'Choose a bundle' | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_variant = bundle_product.selected_or_first_available_variant
              if block.settings.variant_id != blank
                assign wanted_id = block.settings.variant_id | plus: 0
                for variant in bundle_product.variants
                  if variant.id == wanted_id
                    assign block_variant = variant
                  endif
                endfor
              elsif block.settings.variant_position > 0
                assign index = block.settings.variant_position | minus: 1
                assign positioned = bundle_product.variants[index]
                if positioned != blank
                  assign block_variant = positioned
                endif
              endif

              assign bottles = block.settings.bottles | default: 1
              assign allocation = blank
              if has_selling_plans
                assign allocation = block_variant.selling_plan_allocations | first
              endif
            -%}

            <div
              class="bundle__card{% if block.settings.badge != blank %} bundle__card--badged{% endif %}"
              data-bundle-card
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.badge != blank -%}
                <span class="badge bundle__badge">{{ block.settings.badge }}</span>
              {%- endif -%}

              {%- capture price_html -%}
                {% render 'product-price', variant: block_variant, unit_count: bottles %}
              {%- endcapture -%}

              <label class="bundle__label" for="Bundle-{{ section.id }}-{{ block.id }}">
                <input
                  class="bundle__radio"
                  type="radio"
                  name="bundle-{{ section.id }}"
                  id="Bundle-{{ section.id }}-{{ block.id }}"
                  value="{{ block_variant.id }}"
                  data-bundle-option
                  data-label="{{ block.settings.title | escape }}"
                  data-price="{{ price_html | escape }}"
                  {% if allocation != blank %}
                    data-selling-plan="{{ allocation.selling_plan.id }}"
                  {% endif %}
                  {% if block.settings.selected %}
                    checked
                  {% endif %}
                  {% unless block_variant.available %}
                    disabled
                  {% endunless %}
                >

                <span class="bundle__marker" aria-hidden="true"></span>

                <span class="bundle__body">
                  <span class="bundle__title">{{ block.settings.title }}</span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="bundle__subtitle text-small text-secondary">{{ block.settings.subtitle }}</span>
                  {%- endif -%}
                </span>

                <span class="bundle__pricing">
                  <span data-price-onetime>
                    {% render 'product-price', variant: block_variant, unit_count: bottles %}
                  </span>

                  {%- if allocation != blank -%}
                    <span data-price-subscription hidden>
                      <span class="price">
                        <span class="price__current">
                          {%- if settings.currency_code_enabled -%}
                            {{ allocation.price | money_with_currency }}
                          {%- else -%}
                            {{ allocation.price | money }}
                          {%- endif -%}
                        </span>
                        {%- if allocation.compare_at_price > allocation.price -%}
                          <s class="price__compare">{{ allocation.compare_at_price | money }}</s>
                        {%- endif -%}
                        {%- if bottles > 1 -%}
                          {%- assign sub_unit = allocation.price | divided_by: bottles -%}
                          <span class="price__unit">
                            {{- 'products.product.per_bottle' | t: price: sub_unit | money -}}
                          </span>
                        {%- endif -%}
                      </span>
                    </span>
                  {%- endif -%}

                  {%- unless block_variant.available -%}
                    <span class="text-small text-secondary">{{ 'products.product.sold_out' | t }}</span>
                  {%- endunless -%}
                </span>
              </label>
            </div>
          {%- endfor -%}
        </div>

        <product-form class="bundle__form">
          {%- form 'product', bundle_product, id: 'BundleForm', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ bundle_product.selected_or_first_available_variant.id }}" data-variant-input>
            <input type="hidden" name="selling_plan" value="" data-selling-plan-input>
            <input type="hidden" name="quantity" value="1">

            <button class="button button--full bundle__button" type="submit">
              <span data-button-label>{{ section.settings.button_label | default: 'Add to cart' }}</span>
            </button>
            <p class="form-error text-small" data-form-error role="alert" hidden></p>
          {%- endform -%}
        </product-form>

        {%- if section.settings.footnote != blank -%}
          <p class="bundle__footnote text-small text-secondary">{{ section.settings.footnote }}</p>
        {%- endif -%}
      </bundle-selector>
    {%- endif -%}
  </div>
</div>

{% style %}
  .bundle__wrap {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 560px;
    margin-inline: auto;
  }

  .bundle__glow {
    top: 4%;
    left: 50%;
    transform: translateX(-50%);
  }

  .bundle__subscribe {
    margin-bottom: 20px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
  }

  .bundle__switch {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .bundle__switch-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .bundle__switch-track {
    position: relative;
    flex: 0 0 auto;
    width: 44px;
    height: 26px;
    border-radius: 999px;
    background-color: var(--color-silver);
    transition: background-color var(--duration) var(--ease);
  }

  .bundle__switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background-color: var(--color-surface);
    transition: transform var(--duration) ease;
  }

  .bundle__switch-input:checked + .bundle__switch-track {
    background-color: var(--color-accent);
  }

  .bundle__switch-input:checked + .bundle__switch-track .bundle__switch-thumb {
    transform: translateX(18px);
  }

  .bundle__switch-input:focus-visible + .bundle__switch-track {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .bundle__switch-label {
    display: grid;
    gap: 2px;
  }

  .bundle__switch-title {
    font-weight: 600;
  }

  .bundle__options {
    display: grid;
    gap: 12px;
  }

  .bundle__card {
    position: relative;
  }

  .bundle__card--badged {
    padding-top: 12px;
  }

  /* Sits on the card's top edge as a deliberate tab rather than notching it. */
  .bundle__badge {
    position: absolute;
    top: 0;
    left: 24px;
    z-index: 1;
    background-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .bundle__label {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  .bundle__label:hover {
    border-color: var(--color-silver);
  }

  .bundle__card.is-selected .bundle__label {
    border-color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .bundle__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .bundle__marker {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-background);
  }

  .bundle__card.is-selected .bundle__marker {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    box-shadow: inset 0 0 0 4px var(--color-surface);
  }

  .bundle__radio:focus-visible + .bundle__marker {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .bundle__body {
    display: grid;
    gap: 2px;
    flex: 1 1 auto;
  }

  .bundle__title {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .bundle__pricing {
    display: grid;
    gap: 2px;
    text-align: right;
  }

  .bundle__pricing .price {
    justify-content: flex-end;
  }

  .bundle__pricing .price__unit {
    display: block;
    width: 100%;
  }

  .bundle__button {
    margin-top: 20px;
  }

  .bundle__footnote {
    margin: 12px 0 0;
    text-align: center;
  }
{% endstyle %}

{% schema %}
{
  "name": "Bundle selector",
  "tag": "section",
  "class": "bundle-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the featured product from Theme settings."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "bundle",
      "info": "Used by links such as /#bundle in the header."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Choose your supply"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One bottle lasts about 8 weeks"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "Most people start with two. Every order is covered by the 30-day money-back guarantee."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Ships in 7–11 days · 30-day money-back guarantee"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Subscribe and save"
    },
    {
      "type": "checkbox",
      "id": "show_subscribe",
      "label": "Show subscribe and save toggle",
      "default": true,
      "info": "The toggle only appears when the product has a subscription plan attached. Otherwise it is hidden automatically."
    },
    {
      "type": "checkbox",
      "id": "subscribe_default",
      "label": "Subscribe selected by default",
      "default": false
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Toggle label",
      "default": "Subscribe and save 15%"
    },
    {
      "type": "text",
      "id": "subscribe_note",
      "label": "Toggle note",
      "default": "Delivered on your schedule. Skip or cancel any time."
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Bundle option",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1 bottle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Try it for 8 weeks"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "For example: Most popular. Leave empty for no badge."
        },
        {
          "type": "number",
          "id": "bottles",
          "label": "Bottles in this option",
          "default": 1,
          "info": "Used for the per-bottle price."
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Variant ID",
          "info": "Paste the numeric variant ID from admin. Leave empty to use the variant position below."
        },
        {
          "type": "number",
          "id": "variant_position",
          "label": "Variant position",
          "default": 1,
          "info": "1 is the first variant on the product, 2 the second, and so on."
        },
        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle selector",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "title": "1 bottle",
            "subtitle": "Try it for 8 weeks",
            "bottles": 1,
            "variant_position": 1
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "2 bottles",
            "subtitle": "Our most chosen supply",
            "badge": "Most popular",
            "bottles": 2,
            "variant_position": 2,
            "selected": true
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "3 bottles",
            "subtitle": "Best value per bottle",
            "bottles": 3,
            "variant_position": 3
          }
        }
      ]
    }
  ]
}
{% endschema %}
