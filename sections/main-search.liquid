<div class="section main-search">
  <div class="page-width">
    <header class="section__header section__header--center">
      <h1>{{ 'general.search.search' | t }}</h1>
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
        <input
          class="search-form__input"
          id="SearchInput"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <button class="button button--small" type="submit">{{ 'general.search.search' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      <p class="text-center text-secondary">
        {{ 'general.search.results_count' | t: count: search.results_count }}
      </p>

      {%- if search.results_count > 0 -%}
        <ul class="product-grid grid" role="list">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- else -%}
                <a class="product-card__link" href="{{ item.url }}">
                  <h3 class="product-card__title">{{ item.title }}</h3>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% style %}
  .search-form {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 24px;
  }

  .search-form__input {
    flex: 1 1 auto;
    max-width: 360px;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background-color: var(--color-surface);
    color: inherit;
    font: inherit;
  }
{% endstyle %}

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": []
}
{% endschema %}
