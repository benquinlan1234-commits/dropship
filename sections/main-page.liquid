<div class="section main-page">
  <div class="page-width page-width--narrow">
    <header class="main-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1>{{ page.title }}</h1>
    </header>

    <div class="rte main-page__content">{{ page.content }}</div>
  </div>
</div>

{% style %}
  .main-page__header {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .main-page__header h1 {
    margin-bottom: 0;
  }

  .main-page__content h2 {
    margin-top: 2em;
    font-size: 1.375rem;
  }

  .main-page__content h3 {
    margin-top: 1.75em;
  }

  .main-page__content a {
    text-decoration-color: var(--color-silver);
  }
{% endstyle %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Information"
    }
  ]
}
{% endschema %}
