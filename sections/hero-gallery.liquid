{%- liquid
  assign gallery_product = section.settings.product | default: product | default: settings.hero_product
  assign chosen_variant = gallery_product.selected_or_first_available_variant
  assign media_items = gallery_product.media
-%}

<div class="section section--tight product-hero" data-sticky-trigger>
  <div class="page-width">
    {%- if gallery_product == blank -%}
      <p class="text-secondary text-center">
        Choose a featured product in Theme settings &rarr; Product to show this section.
      </p>
    {%- else -%}
      <div class="product-hero__grid">
        <media-gallery class="product-hero__gallery">
          <div class="product-hero__viewer" data-gallery-viewer>
            {%- if media_items.size > 0 -%}
              {%- for media in media_items -%}
                <div class="product-hero__slide" data-gallery-slide="{{ forloop.index0 }}">
                  {%- if media.media_type == 'video' -%}
                    <div class="media media--square">
                      {{ media | video_tag: image_size: '1200x', controls: true, muted: true }}
                    </div>
                  {%- else -%}
                    <div class="media media--square">
                      <img
                        src="{{ media | image_url: width: 1200 }}"
                        srcset="
                          {{ media | image_url: width: 600 }} 600w,
                          {{ media | image_url: width: 900 }} 900w,
                          {{ media | image_url: width: 1200 }} 1200w
                        "
                        sizes="(min-width: 990px) 52vw, 100vw"
                        width="{{ media.preview_image.width }}"
                        height="{{ media.preview_image.height }}"
                        alt="{{ media.alt | escape }}"
                        {% if forloop.first %}
                          loading="eager"
                          fetchpriority="high"
                        {% else %}
                          loading="lazy"
                        {% endif %}
                      >
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="product-hero__slide">
                <div class="media media--square">
                  <div class="placeholder-media"></div>
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if media_items.size > 1 -%}
            <ul class="product-hero__thumbs" role="list" aria-label="{{ 'products.product.media_gallery' | t }}">
              {%- for media in media_items -%}
                <li>
                  <button
                    class="product-hero__thumb"
                    type="button"
                    data-gallery-thumb="{{ forloop.index0 }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="{{ media.alt | default: gallery_product.title | escape }}"
                  >
                    <img
                      src="{{ media | image_url: width: 200 }}"
                      srcset="{{ media | image_url: width: 100 }} 1x, {{ media | image_url: width: 200 }} 2x"
                      width="72"
                      height="72"
                      alt=""
                      loading="lazy"
                    >
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </media-gallery>

        <div class="product-hero__info">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
          {%- endif -%}

          <h1 class="product-hero__title">
            {{- section.settings.heading | default: gallery_product.title -}}
          </h1>

          {%- if section.settings.subheading != blank -%}
            <p class="product-hero__subheading text-secondary">{{ section.settings.subheading }}</p>
          {%- endif -%}

          {%- if section.settings.show_rating -%}
            <div class="product-hero__rating">
              {% render 'star-rating',
                rating: section.settings.rating_value,
                count_text: section.settings.review_count_text
              %}
            </div>
          {%- endif -%}

          <div class="product-hero__price">
            {% render 'product-price', variant: chosen_variant, large: true %}
          </div>

          <product-form class="product-hero__form">
            {%- form 'product', gallery_product, id: 'ProductHeroForm', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ chosen_variant.id }}" data-variant-input>
              <input type="hidden" name="selling_plan" value="" data-selling-plan-input>
              <input type="hidden" name="quantity" value="1">

              <button
                class="button button--full"
                type="submit"
                {% unless chosen_variant.available %}
                  disabled
                {% endunless %}
              >
                <span data-button-label>
                  {%- if chosen_variant.available -%}
                    {{ section.settings.button_label | default: 'Add to cart' }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>
              <p class="form-error text-small" data-form-error role="alert" hidden></p>
            {%- endform -%}
          </product-form>

          {%- if section.settings.trust_line != blank -%}
            <p class="product-hero__trust text-small text-secondary">{{ section.settings.trust_line }}</p>
          {%- endif -%}

          {%- if section.settings.show_description and gallery_product.description != blank -%}
            <div class="rte text-secondary product-hero__description">
              {{ gallery_product.description }}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  .product-hero__grid {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  .product-hero__viewer {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: none;
    border-radius: var(--radius);
  }

  .product-hero__viewer::-webkit-scrollbar {
    display: none;
  }

  .product-hero__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .product-hero__thumbs {
    display: flex;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .product-hero__thumbs::-webkit-scrollbar {
    display: none;
  }

  .product-hero__thumb {
    display: block;
    width: 72px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--duration) var(--ease);
  }

  .product-hero__thumb img {
    width: 100%;
    height: 72px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .product-hero__thumb[aria-current='true'] {
    border-color: var(--color-accent);
  }

  .product-hero__title {
    margin: 0 0 14px;
    font-size: clamp(1.875rem, 4.4vw, 2.75rem);
  }

  .product-hero__subheading {
    max-width: 44ch;
    margin: 0 0 22px;
  }

  .product-hero__rating {
    margin-bottom: 22px;
  }

  .product-hero__price {
    margin-bottom: 24px;
  }

  .product-hero__trust {
    margin: 16px 0 0;
  }

  .product-hero__description {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  @media screen and (min-width: 990px) {
    .product-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }

    .product-hero__info {
      position: sticky;
      top: 96px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product hero",
  "tag": "section",
  "class": "product-hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The gallery version of the hero. Use this on the product template, and Hero video on the home page."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the template's product, or the featured product from Theme settings."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Hyaluronic PDRN orb serum"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the product title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "Salmon DNA serum, sealed in each orb until it touches your skin."
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "45g · Ships in 7–11 days · 30-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the product description",
      "default": false
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Star rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "2,431 reviews"
    }
  ],
  "presets": [{ "name": "Product hero" }]
}
{% endschema %}
