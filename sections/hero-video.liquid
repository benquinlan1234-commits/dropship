{%- liquid
  assign hero_product = section.settings.product | default: settings.hero_product
  assign chosen_variant = hero_product.selected_or_first_available_variant
  if section.settings.variant_id != blank
    assign wanted_id = section.settings.variant_id | plus: 0
    for variant in hero_product.variants
      if variant.id == wanted_id
        assign chosen_variant = variant
      endif
    endfor
  endif
  assign is_overlay = false
  if section.settings.layout == 'overlay'
    assign is_overlay = true
  endif

  comment
    A product photograph is rarely the shape of the frame it lands in. Cropping
    one to a tall pill eats a third of its width, which on a packshot means the
    box loses its top. Default to showing all of it and letting the pearl fill
    carry the rest.
  endcomment
  comment
    The frame carries the radius as well as the ratio. An oval is right for a
    tall crop and wrong for a square one: it would take the corners off a
    packshot, which is the crop this setting exists to avoid.
  endcomment
  case section.settings.media_shape
    when 'portrait'
      assign media_ratio = '4 / 5'
      assign media_radius = '52px'
      assign media_bleed = '0px'
      assign media_gutter = 'var(--content-inset)'
    when 'square'
      assign media_ratio = '1 / 1'
      assign media_radius = '52px'
      assign media_bleed = '0px'
      assign media_gutter = 'var(--content-inset)'
    else
      assign media_ratio = '3 / 4.4'
      assign media_radius = '220px 220px 220px 220px / 180px 180px 180px 180px'
      assign media_bleed = '-6vw'
      assign media_gutter = '0px'
  endcase

  comment
    The product already carries its photography. Fall back to it so linking the
    featured product is the only step needed to light the hero up.
  endcomment
  assign hero_media = hero_product.featured_media
  assign wanted_media = section.settings.product_image | minus: 1
  if wanted_media > 0 and hero_product.media[wanted_media] != blank
    assign hero_media = hero_product.media[wanted_media]
  endif

  assign hero_poster = section.settings.poster
  if hero_poster == blank
    assign hero_poster = hero_media.preview_image
  endif

  assign hero_poster_alt = section.settings.poster_alt
  if hero_poster_alt == blank
    assign hero_poster_alt = hero_media.alt | default: hero_product.title
  endif
-%}

<section
  class="hero hero--{{ section.settings.layout }}{% unless is_overlay %} section--wash{% endunless %}"
  data-sticky-trigger
  style="--hero-height: {{ section.settings.height }}vh; --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text: {{ section.settings.text_color }}; --media-fit: {{ section.settings.media_fit | default: 'contain' }}; --media-ratio: {{ media_ratio }}; --media-radius: {{ media_radius }}; --media-bleed: {{ media_bleed }}; --media-gutter: {{ media_gutter }};"
>
  {%- unless is_overlay -%}
    <span class="orb hero__orb" aria-hidden="true"></span>
  {%- endunless -%}

  <div class="hero__grid">
    <div class="hero__media parallax" data-parallax="0.06">
      <div class="media {% if is_overlay %}media--fill{% else %}media--tall media--pill{% endif %}">
        {% render 'video',
          shopify_video: section.settings.video,
          mp4_url: section.settings.video_mp4_url,
          webm_url: section.settings.video_webm_url,
          poster: hero_poster,
          alt: hero_poster_alt,
          ratio: media_ratio,
          loading_eager: true
        %}
      </div>
      {%- if is_overlay -%}
        <div class="hero__scrim" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow rise" style="--rise-index: 0;">
          {%- if section.settings.eyebrow_icon != 'none' -%}
            {% render 'icon', icon: section.settings.eyebrow_icon %}
          {%- endif -%}
          <span>{{ section.settings.eyebrow }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hero__heading rise" style="--rise-index: 1;">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="lede hero__lede rise" style="--rise-index: 2;">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.show_rating and section.settings.review_count_text != blank -%}
        <div class="hero__rating rise" style="--rise-index: 3;">
          {% render 'star-rating',
            rating: section.settings.rating_value,
            count_text: section.settings.review_count_text
          %}
        </div>
      {%- endif -%}

      {%- if hero_product != blank -%}
        <div class="hero__buy rise" style="--rise-index: 4;">
          {%- comment -%}
            Display only. The offer section below is the single place to buy —
            a second add-to-cart here would mean two prices and two checkout
            paths for one product.
          {%- endcomment -%}
          {%- if section.settings.show_price -%}
            <p class="hero__price">
              {%- if hero_product.price_varies -%}
                <span class="hero__price-prefix">{{ section.settings.price_prefix }}</span>
              {%- endif -%}
              {% render 'product-price', variant: chosen_variant, large: true, show_compare: false %}
            </p>
          {%- endif -%}

          <div class="hero__actions">
            <a
              class="button hero__button{% if is_overlay %} button--light{% endif %}"
              href="{{ section.settings.button_link | default: '#bundle' }}"
            >
              {{- section.settings.button_label | default: 'Choose your bundle' -}}
            </a>

            {%- if section.settings.link_label != blank -%}
              <a class="link-quiet hero__link" href="{{ section.settings.link_url | default: '#how' }}">
                <span>{{ section.settings.link_label }}</span>
                {% render 'icon', icon: 'arrow-down' %}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <p class="lede">
          Choose a featured product in Theme settings &rarr; Product to show the price here.
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__stats rise" style="--rise-index: 5;" role="list">
          {%- for block in section.blocks -%}
            <li class="hero__stat" {{ block.shopify_attributes }}>
              {%- if block.settings.value != blank -%}
                <span class="numeral hero__stat-value">{{ block.settings.value }}</span>
              {%- endif -%}
              <span class="hero__stat-label">{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__orb {
    --orb-size: min(760px, 90vw);
    top: -18%;
    right: -12%;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 36px;
    padding-block: 48px 56px;
  }

  .hero__copy {
    padding-inline: var(--gutter);
  }

  .hero__media {
    padding-inline: var(--gutter);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .hero__eyebrow .icon {
    width: 15px;
    height: 15px;
  }

  .hero__heading {
    margin: 0 0 20px;
    max-width: 11ch;
  }

  .hero__lede {
    margin: 0 0 26px;
  }

  .hero__rating {
    margin-bottom: 26px;
  }

  .hero__price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 24px;
  }

  .hero__price-prefix {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .hero--overlay .hero__price-prefix {
    color: inherit;
    opacity: 0.8;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .hero__button {
    min-width: 240px;
  }

  /* A thin silver rule, then the three facts that answer "is this for me". */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 18px;
    margin: 36px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid transparent;
    border-image: var(--silver-line) 1;
    list-style: none;
  }

  .hero__stat {
    display: grid;
    gap: 2px;
    align-content: start;
  }

  /* Hairline separators rather than inline dots: a wrapped row can never
     orphan a marker at the start of a line. */
  .hero__stat + .hero__stat {
    padding-left: 18px;
    border-left: 1px solid transparent;
    border-image: var(--silver-line-v) 1;
  }

  .hero__stat-value {
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .hero__stat-label {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media screen and (min-width: 990px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
      align-items: center;
      gap: 64px;
      padding-block: 88px 96px;
    }

    .hero__copy {
      order: 1;
      padding-inline: 0;
      padding-left: var(--content-inset);
      max-width: 620px;
    }

    /* The tall pill runs past the right edge of the viewport, which is what
       makes the composition asymmetric. A square or portrait frame does not:
       bleeding one off-screen cuts the feathered edge off on that side and
       leaves the photograph looking half-finished against the window. */
    .hero__media {
      order: 2;
      padding-inline: 0 var(--media-gutter, 0);
      margin-right: var(--media-bleed, 0);
    }

    .hero__media .media--tall {
      max-height: 78vh;
      max-width: 100%;
    }
  }

  /* The original full-bleed video layout, kept as an option. */
  .hero--overlay {
    color: var(--hero-text);
  }

  .hero--overlay .hero__media {
    position: absolute;
    inset: 0;
    padding: 0;
    margin: 0;
  }

  .hero--overlay .media--fill,
  .hero--overlay .media--fill .video-wrapper {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  .hero--overlay .hero__scrim {
    position: absolute;
    inset: 0;
    background-color: rgba(var(--color-deep-rgb), var(--hero-overlay, 0.34));
  }

  .hero--overlay .hero__grid {
    display: block;
    min-height: var(--hero-height, 82vh);
    padding-block: 0;
  }

  .hero--overlay .hero__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: var(--hero-height, 82vh);
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: 56px;
  }

  .hero--overlay .eyebrow,
  .hero--overlay .lede,
  .hero--overlay .hero__stat-label,
  .hero--overlay .rating,
  .hero--overlay .price__compare,
  .hero--overlay .price__unit {
    color: inherit;
    opacity: 0.88;
  }

  @media screen and (min-width: 990px) {
    .hero--overlay .hero__copy {
      justify-content: center;
      max-width: var(--page-width);
      padding-left: var(--gutter);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "A Shopify-hosted video. Muted, looping and autoplaying, unless the visitor asks for reduced motion."
    },
    {
      "type": "url",
      "id": "video_mp4_url",
      "label": "MP4 URL",
      "info": "Optional. Upload an .mp4 under Content > Files and paste its URL. Used before the Shopify-hosted video."
    },
    {
      "type": "url",
      "id": "video_webm_url",
      "label": "WebM URL",
      "info": "Optional. Upload a .webm under Content > Files and paste its URL. Served first where supported."
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Show the whole photo" },
        { "value": "cover", "label": "Fill the frame (crops)" }
      ],
      "default": "contain",
      "info": "Supplier packshots are rarely the shape of the frame. Filling it crops the edges, which on a box shot usually takes the top off."
    },
    {
      "type": "select",
      "id": "media_shape",
      "label": "Image frame shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "tall", "label": "Tall pill" }
      ],
      "default": "square",
      "info": "The closer this is to the shape of your photo, the less empty space around it."
    },
    {
      "type": "range",
      "id": "product_image",
      "label": "Which product photo",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "info": "Counts through the product's own media in admin order. Ignored when a poster image is uploaded below."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown before the video loads, and instead of it for reduced-motion visitors. Leave empty to use the featured product's own first photo."
    },
    {
      "type": "text",
      "id": "poster_alt",
      "label": "Poster alt text",
      "info": "Leave empty to use the product photo's own alt text."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "eyebrow_icon",
      "label": "Eyebrow icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "drop", "label": "Drop" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "leaf", "label": "Leaf" }
      ],
      "default": "drop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Hyaluronic PDRN orb serum"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "PDRN in a capsule."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "Salmon DNA serum, sealed in each orb until it touches your skin."
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "paragraph",
      "content": "The hero displays the product. Buying happens once, in the offer section below, so this button scrolls there rather than adding to cart."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose your bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the offer section on this page."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show the price",
      "default": false,
      "info": "Off by default. The offer section below already prices every option, and two prices above the fold read as two different products."

    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From",
      "info": "Shown only when the product has more than one price."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Text link label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Text link URL",
      "info": "Defaults to the How it works section on this page."
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true,
      "info": "Nothing renders until you fill in the review count below."
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Star rating",
      "info": "For example 4.8."
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "info": "For example 2,431 reviews. Leave empty until you have real numbers."
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the featured product from Theme settings."
    },
    {
      "type": "text",
      "id": "variant_id",
      "label": "Variant ID",
      "info": "Optional. The variant this button adds — paste the numeric ID from the product's variant URL in admin. Defaults to the first available variant."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "editorial", "label": "Editorial — copy left, media bleeding right" },
        { "value": "overlay", "label": "Full-bleed video with text over it" }
      ],
      "default": "editorial"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 82,
      "info": "Only applies to the full-bleed layout."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "Only applies to the full-bleed layout."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text over video",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Micro-stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "30,000ppm",
          "info": "Set in the display face. Leave empty for a label on its own."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Hyaluronic PDRN"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero video",
      "blocks": [
        { "type": "stat", "settings": { "value": "30,000ppm", "label": "Hyaluronic PDRN" } },
        { "type": "stat", "settings": { "value": "45 g", "label": "Net weight" } },
        { "type": "stat", "settings": { "value": "30 days", "label": "Money-back guarantee" } }
      ]
    }
  ]
}
{% endschema %}
