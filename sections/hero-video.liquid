{%- liquid
  assign hero_product = section.settings.product | default: settings.hero_product
  assign chosen_variant = hero_product.selected_or_first_available_variant
  if section.settings.variant_id != blank
    assign wanted_id = section.settings.variant_id | plus: 0
    for variant in hero_product.variants
      if variant.id == wanted_id
        assign chosen_variant = variant
      endif
    endfor
  endif
-%}

<section
  class="hero{% if section.settings.layout == 'split' %} hero--split{% endif %}"
  data-sticky-trigger
  style="--hero-height: {{ section.settings.height }}vh; --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text: {{ section.settings.text_color }};"
>
  <div class="hero__media">
    {% render 'video',
      shopify_video: section.settings.video,
      mp4_url: section.settings.video_mp4_url,
      webm_url: section.settings.video_webm_url,
      poster: section.settings.poster,
      alt: section.settings.poster_alt,
      ratio: '16 / 9',
      loading_eager: true
    %}
    <div class="hero__scrim" role="presentation"></div>
  </div>

  <div class="hero__content">
    <div class="page-width hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow text-eyebrow">
          {%- if section.settings.eyebrow_icon != 'none' -%}
            {% render 'icon', icon: section.settings.eyebrow_icon %}
          {%- endif -%}
          <span>{{ section.settings.eyebrow }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hero__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.show_rating -%}
        <div class="hero__rating">
          {% render 'star-rating',
            rating: section.settings.rating_value,
            count_text: section.settings.review_count_text
          %}
        </div>
      {%- endif -%}

      {%- if hero_product != blank -%}
        <div class="hero__price">
          {% render 'product-price', variant: chosen_variant, large: true %}
        </div>

        <product-form class="hero__form">
          {%- form 'product', hero_product, id: 'HeroProductForm', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ chosen_variant.id }}" data-variant-input>
            <input type="hidden" name="quantity" value="1">
            <button
              class="button hero__button"
              type="submit"
              {% unless chosen_variant.available %}
                disabled
              {% endunless %}
            >
              <span data-button-label>
                {%- if chosen_variant.available -%}
                  {{ section.settings.button_label | default: 'Add to cart' }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>
            <p class="form-error text-small" data-form-error role="alert" hidden></p>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <p class="hero__subheading">
          Choose a featured product in Theme settings &rarr; Product to show the price and add to cart button.
        </p>
      {%- endif -%}

      {%- if section.settings.trust_line != blank -%}
        <p class="hero__trust text-small">{{ section.settings.trust_line }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .hero {
    position: relative;
    color: var(--hero-text);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero--split .hero__media {
    position: relative;
    inset: auto;
  }

  .hero__media .video-wrapper,
  .hero__media .video-wrapper__video,
  .hero__media .video-wrapper__poster,
  .hero__media .placeholder-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero--split .hero__media .video-wrapper {
    aspect-ratio: var(--video-ratio, 16 / 9);
    height: auto;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background-color: rgba(var(--color-text-rgb), var(--hero-overlay, 0.25));
  }

  .hero--split .hero__scrim {
    display: none;
  }

  .hero__content {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: var(--hero-height, 78vh);
    padding-block: 48px;
  }

  .hero--split {
    color: var(--color-text);
  }

  .hero--split .hero__content {
    min-height: 0;
    align-items: flex-start;
    padding-block: var(--section-padding-mobile);
  }

  .hero__inner {
    max-width: 620px;
    margin-inline: 0;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    opacity: 0.9;
  }

  .hero__eyebrow .icon {
    width: 16px;
    height: 16px;
  }

  .hero__heading {
    margin: 0 0 16px;
  }

  .hero__subheading {
    max-width: 46ch;
    margin: 0 0 20px;
    font-size: 1.0625rem;
    opacity: 0.9;
  }

  .hero__rating {
    margin-bottom: 20px;
  }

  .hero__rating .rating,
  .hero__rating .rating__stars {
    color: inherit;
  }

  .hero__price {
    margin-bottom: 20px;
  }

  .hero__price .price__compare,
  .hero__price .price__unit {
    color: inherit;
    opacity: 0.75;
  }

  .hero__button {
    width: 100%;
  }

  .hero__trust {
    margin: 16px 0 0;
    opacity: 0.8;
  }

  @media screen and (min-width: 750px) {
    .hero__content {
      align-items: center;
      padding-block: 80px;
    }

    .hero--split .hero__content {
      padding-block: var(--section-padding-desktop);
    }

    .hero__inner {
      margin-inline: auto;
    }

    .hero__button {
      width: auto;
      min-width: 260px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "A Shopify-hosted video. Muted, looping and autoplaying, unless the visitor asks for reduced motion."
    },
    {
      "type": "url",
      "id": "video_mp4_url",
      "label": "MP4 URL",
      "info": "Optional. Upload an .mp4 under Content > Files and paste its URL. Used before the Shopify-hosted video."
    },
    {
      "type": "url",
      "id": "video_webm_url",
      "label": "WebM URL",
      "info": "Optional. Upload a .webm under Content > Files and paste its URL. Served first where supported."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown before the video loads, and instead of it for reduced-motion visitors."
    },
    {
      "type": "text",
      "id": "poster_alt",
      "label": "Poster alt text",
      "default": "A hand holding the serum bottle in soft daylight"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "eyebrow_icon",
      "label": "Eyebrow icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "drop", "label": "Drop" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "leaf", "label": "Leaf" }
      ],
      "default": "drop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Hyaluronic PDRN orb serum"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "PDRN in a capsule."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "Salmon DNA serum, sealed in each orb until it touches your skin."
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "45g · For all skin types · 30-day money-back guarantee"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Star rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "2,431 reviews"
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to use the featured product from Theme settings."
    },
    {
      "type": "text",
      "id": "variant_id",
      "label": "Variant ID",
      "info": "Optional. The variant this button adds — paste the numeric ID from the product's variant URL in admin. Defaults to the first available variant."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Text over video" },
        { "value": "split", "label": "Text under video" }
      ],
      "default": "overlay"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 78,
      "info": "Only applies to the text-over-video layout."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text over video",
      "default": "#FFFFFF"
    }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
