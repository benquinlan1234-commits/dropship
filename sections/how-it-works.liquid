<div
  class="section how{% if section.settings.show_divider %} section--bordered{% endif %}"
  id="{{ section.settings.anchor | default: 'how' }}"
>
  <div class="page-width">
    <div class="how__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="how__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="lede how__lede">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <ol class="how__steps" role="list">
      {%- for block in section.blocks -%}
        <li class="step reveal" {{ block.shopify_attributes }}>
          {%- comment -%}
            The numeral sits behind the copy like a magazine folio, so the eye
            reads the instruction first and the sequence second.
          {%- endcomment -%}
          <span class="numeral step__folio" aria-hidden="true">
            {%- if section.settings.number_style == 'number' -%}
              {{ forloop.index }}
            {%- else -%}
              {{ forloop.index | prepend: '0' }}
            {%- endif -%}
          </span>

          <div class="step__body">
            {%- if block.settings.image != blank -%}
              <div class="media media--landscape step__media">
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 350 }} 350w,
                    {{ block.settings.image | image_url: width: 700 }} 700w
                  "
                  sizes="(min-width: 750px) 33vw, 100vw"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="step__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="step__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% style %}
  .how__header {
    display: grid;
    gap: 20px;
    margin-bottom: 56px;
  }

  .how__heading {
    margin-bottom: 0;
    max-width: 16ch;
  }

  .how__steps {
    display: grid;
    gap: 44px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    padding-top: 34px;
    border-top: 1px solid var(--color-border);
  }

  .step__folio {
    position: absolute;
    top: 2px;
    left: -6px;
    z-index: 0;
    font-size: 5.5rem;
    line-height: 0.9;
    color: var(--color-accent);
    opacity: 0.18;
    user-select: none;
  }

  .step__body {
    position: relative;
    z-index: 1;
  }

  .step__media {
    margin-bottom: 22px;
  }

  .step__title {
    margin: 0 0 10px;
    font-size: 1.25rem;
    max-width: 20ch;
  }

  .step__text {
    margin: 0;
    max-width: 34ch;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  @media screen and (min-width: 750px) {
    .how__header {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: end;
      gap: 48px;
    }

    .how__lede {
      padding-bottom: 6px;
    }

    .how__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--grid-gap);
    }

    .step {
      padding-top: 44px;
    }

    .step__folio {
      font-size: 7rem;
      top: -8px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "how-it-works-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "how",
      "info": "Used by the hero's text link, /#how."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps, morning and night"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "The orbs stay whole in the bottle. You break them open yourself."
    },
    {
      "type": "select",
      "id": "number_style",
      "label": "Step numbers",
      "options": [
        { "value": "padded", "label": "01, 02, 03" },
        { "value": "number", "label": "1, 2, 3" }
      ],
      "default": "padded"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tap 2–3 orbs onto your palm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Tip the bottle gently. The orbs stay whole until you press them."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Tap 2–3 orbs onto your palm",
            "text": "Tip the bottle gently. The orbs stay whole until you press them."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Press to burst them into serum",
            "text": "A light press is enough. The orbs collapse into a clear, watery serum."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Pat into clean skin, morning and night",
            "text": "Press it in with your fingertips, then follow with moisturiser."
          }
        }
      ]
    }
  ]
}
{% endschema %}
