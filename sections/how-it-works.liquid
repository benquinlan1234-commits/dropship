<div class="section how-it-works{% if section.settings.show_divider %} section--bordered{% endif %}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section__header section__header--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="how-it-works__steps grid grid--3" role="list">
      {%- for block in section.blocks -%}
        <li class="how-it-works__step reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media media--landscape how-it-works__media">
              <img
                src="{{ block.settings.image | image_url: width: 700 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 350 }} 350w,
                  {{ block.settings.image | image_url: width: 700 }} 700w
                "
                sizes="(min-width: 750px) 33vw, 100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image_alt | escape }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}

          <p class="how-it-works__number" aria-hidden="true">
            {%- if section.settings.number_style == 'number' -%}
              {{ forloop.index }}
            {%- else -%}
              {{ forloop.index | prepend: '0' }}
            {%- endif -%}
          </p>

          {%- if block.settings.icon != 'none' and block.settings.image == blank -%}
            <span class="how-it-works__icon">{% render 'icon', icon: block.settings.icon, size: 'lg' %}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="how-it-works__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="text-secondary">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% style %}
  .how-it-works__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: steps;
  }

  .how-it-works__media {
    margin-bottom: 16px;
  }

  .how-it-works__number {
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .how-it-works__icon {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .how-it-works__title {
    margin: 0 0 6px;
    font-size: 1.0625rem;
  }

  .how-it-works__step p:last-child {
    margin-bottom: 0;
    font-size: 0.9375rem;
  }
{% endstyle %}

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "how-it-works-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps, morning and night"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "The orbs stay whole in the bottle. You break them open yourself."
    },
    {
      "type": "select",
      "id": "number_style",
      "label": "Step numbers",
      "options": [
        { "value": "padded", "label": "01, 02, 03" },
        { "value": "number", "label": "1, 2, 3" }
      ],
      "default": "padded"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tap 2–3 orbs onto your palm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Tip the bottle gently. The orbs stay whole until you press them."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "drop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Replaces the icon."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Tap 2–3 orbs onto your palm",
            "text": "Tip the bottle gently. The orbs stay whole until you press them.",
            "icon": "drop"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Press to burst them into serum",
            "text": "A light press is enough. The orbs collapse into a clear, watery serum.",
            "icon": "sparkle"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Pat into clean skin, morning and night",
            "text": "Press it in with your fingertips, then follow with moisturiser.",
            "icon": "check"
          }
        }
      ]
    }
  ]
}
{% endschema %}
