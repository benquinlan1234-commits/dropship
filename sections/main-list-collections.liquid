<div class="section main-list-collections">
  <div class="page-width">
    <header class="section__header section__header--center">
      <h1>{{ page_title }}</h1>
    </header>

    <ul class="product-grid grid" role="list">
      {%- for collection in collections -%}
        <li>
          <a class="product-card__link" href="{{ collection.url }}">
            <div class="media media--portrait">
              {%- if collection.featured_image -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="placeholder-media">{{ 'collection-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>
            <h2 class="product-card__title">{{ collection.title }}</h2>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": []
}
{% endschema %}
