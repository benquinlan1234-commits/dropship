<div class="section faq{% if section.settings.show_divider %} section--bordered{% endif %}" id="{{ section.settings.anchor | default: 'faq' }}">
  <div class="page-width">
    <div class="faq__layout">
      <div class="faq__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lede">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="link-quiet faq__link" href="{{ section.settings.link_url | default: '#' }}">
            <span>{{ section.settings.link_label }}</span>
            {% render 'icon', icon: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>

      <accordion-group class="faq__list" data-exclusive="{{ section.settings.one_at_a_time }}">
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
            <summary class="accordion__summary">
              <span class="accordion__question">{{ block.settings.question }}</span>
              <span class="accordion__marker" aria-hidden="true">
                {% render 'icon', icon: 'plus', extra_class: 'accordion__plus' %}
                {% render 'icon', icon: 'minus', extra_class: 'accordion__minus' %}
              </span>
            </summary>
            <div class="accordion__panel">
              <div class="rte text-secondary">{{ block.settings.answer }}</div>
            </div>
          </details>
        {%- endfor -%}
      </accordion-group>
    </div>
  </div>
</div>

{% style %}
  /* One column, centred. Questions in the display face. */
  .faq__layout {
    max-width: 760px;
    margin-inline: auto;
  }

  .faq__intro {
    margin-bottom: 40px;
  }

  .faq__intro h2 {
    margin-bottom: 16px;
  }

  .faq__link {
    margin-top: 24px;
  }

  .accordion {
    border-top: 1px solid var(--color-border);
  }

  .accordion:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0;
    cursor: pointer;
    list-style: none;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .accordion__question {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-optical-sizing: auto;
    font-size: 1.25rem;
    letter-spacing: var(--display-tracking);
    line-height: 1.3;
  }

  .accordion__marker {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--color-silver);
    border-radius: 50%;
    color: var(--color-accent);
    transition: border-color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  .accordion__marker .icon {
    position: absolute;
    width: 15px;
    height: 15px;
  }

  .accordion__minus {
    opacity: 0;
  }

  .accordion[open] .accordion__plus {
    opacity: 0;
  }

  .accordion[open] .accordion__minus {
    opacity: 1;
  }

  .accordion[open] .accordion__marker {
    border-color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .accordion__panel {
    padding: 0 0 28px;
    max-width: 60ch;
    font-size: 0.9375rem;
  }

  @media screen and (min-width: 750px) {
    .accordion__question {
      font-size: 1.4375rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "faq",
      "info": "Used by links such as /#faq in the header."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "Everything we get asked most often about the orbs, the formula and delivery."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read the full FAQ"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "one_at_a_time",
      "label": "Open one question at a time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is PDRN?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>PDRN stands for polydeoxyribonucleotide, a fragment of DNA sourced from salmon. In skincare it is used as a hydrating, conditioning ingredient. Ours sits at 30,000ppm alongside hyaluronic acid.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is PDRN?",
            "answer": "<p>PDRN stands for polydeoxyribonucleotide, a fragment of DNA sourced from salmon. In skincare it is used as a hydrating, conditioning ingredient. Ours sits at 30,000ppm alongside hyaluronic acid, and it is designed to support skin that feels dry or looks uneven.</p>",
            "open": true
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is it vegan?",
            "answer": "<p>No. PDRN is salmon-derived, so the serum is not vegan. It is not tested on animals.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders arrive in 7–11 days. You will get a tracking link by email as soon as your parcel leaves our warehouse.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Which skin types is it for?",
            "answer": "<p>It is designed for all skin types, including sensitive skin. The texture is light and water-like, so oily and combination skin can use it without a heavy finish. If you react easily, patch test on your inner arm for 24 hours first.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "<p>The 45g bottle holds about eight weeks of use at 2–3 orbs, morning and night. Most people order two bottles so they do not run out mid-routine.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is the guarantee?",
            "answer": "<p>Thirty days. If it is not working for your skin, email us within 30 days of delivery and we will refund you — even if the bottle is open.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
