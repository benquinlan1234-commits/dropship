<div class="section ingredients{% if section.settings.show_divider %} section--bordered{% endif %}">
  <div class="page-width">
    <div class="ingredients__grid">
      <div class="ingredients__intro reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ingredients__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lede">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          <figure class="ingredients__figure">
            <div class="media media--landscape">
              <img
                src="{{ section.settings.image | image_url: width: 900 }}"
                srcset="
                  {{ section.settings.image | image_url: width: 450 }} 450w,
                  {{ section.settings.image | image_url: width: 900 }} 900w
                "
                sizes="(min-width: 990px) 42vw, 100vw"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                alt="{{ section.settings.image_alt | escape }}"
                loading="lazy"
              >
            </div>
            {%- if section.settings.image_caption != blank -%}
              <figcaption class="text-small text-secondary">{{ section.settings.image_caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>

      <ul class="ingredients__list" role="list">
        {%- for block in section.blocks -%}
          <li class="ingredient reveal" {{ block.shopify_attributes }}>
            <span class="icon-ring ingredient__icon">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 96 }}"
                  srcset="{{ block.settings.image | image_url: width: 48 }} 1x, {{ block.settings.image | image_url: width: 96 }} 2x"
                  width="22"
                  height="22"
                  alt="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                >
              {%- elsif block.settings.icon != 'none' -%}
                {% render 'icon', icon: block.settings.icon %}
              {%- endif -%}
            </span>

            <div class="ingredient__body">
              {%- if block.settings.title != blank -%}
                <h3 class="ingredient__name">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.benefit != blank -%}
                <p class="ingredient__benefit">{{ block.settings.benefit }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.figure != blank -%}
              <span class="numeral ingredient__figure">{{ block.settings.figure }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% style %}
  .ingredients__grid {
    display: grid;
    gap: 44px;
    align-items: start;
  }

  .ingredients__heading {
    margin-bottom: 20px;
  }

  .ingredients__figure {
    margin: 36px 0 0;
  }

  .ingredients__figure figcaption {
    margin-top: 14px;
    max-width: 34ch;
  }

  .ingredients__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  /* Rows separated by hairlines, not a row of boxes. */
  .ingredient {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    align-items: center;
    column-gap: 20px;
    row-gap: 10px;
    padding-block: 26px;
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--duration) var(--ease);
  }

  .ingredient__icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .ingredient__name {
    margin: 0 0 2px;
    font-size: 1.3125rem;
  }

  .ingredient__benefit {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  /* The figure is the data point: display face, larger than everything beside it. */
  .ingredient__figure {
    grid-column: 2;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-accent-ink);
  }

  @media screen and (min-width: 750px) {
    .ingredient {
      grid-template-columns: 54px minmax(0, 1fr) auto;
      column-gap: 28px;
      padding-block: 32px;
    }

    .ingredient__figure {
      grid-column: 3;
      font-size: 2.25rem;
      text-align: right;
    }
  }

  @media screen and (min-width: 990px) {
    .ingredients__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 72px;
    }

    .ingredients__heading {
      font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Ingredient cards",
  "tag": "section",
  "class": "ingredients-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What is inside"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three actives. Nothing else."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subhead",
      "default": "A short ingredient list, designed to support hydration and a comfortable barrier."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "header",
      "content": "Supporting image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. A close-up of the ingredient list on the box works well here."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Close-up of the ingredient list printed on the box"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "The full list is printed on the box, and in the product details below."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Hyaluronic PDRN"
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "One-line benefit",
          "default": "Repair & renewal"
        },
        {
          "type": "text",
          "id": "figure",
          "label": "Figure",
          "default": "30,000ppm",
          "info": "Set large in the display face. Leave empty if there is no number worth showing."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" }
          ],
          "default": "drop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Replaces the icon."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient cards",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Hyaluronic PDRN",
            "benefit": "Repair & renewal",
            "figure": "30,000ppm",
            "icon": "drop"
          }
        },
        {
          "type": "ingredient",
          "settings": { "title": "Ectoin", "benefit": "Barrier protection", "figure": "", "icon": "shield" }
        },
        {
          "type": "ingredient",
          "settings": { "title": "Glutathione", "benefit": "Brightening", "figure": "", "icon": "sparkle" }
        }
      ]
    }
  ]
}
{% endschema %}
