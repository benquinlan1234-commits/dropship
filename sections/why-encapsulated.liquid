<div class="section why{% if section.settings.show_divider %} section--bordered{% endif %}">
  <div class="page-width">
    <div class="why__grid{% if section.settings.image_position == 'right' %} why__grid--reverse{% endif %}">
      <div class="why__media reveal">
        {%- if section.settings.image != blank -%}
          <div class="media media--portrait">
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              srcset="
                {{ section.settings.image | image_url: width: 500 }} 500w,
                {{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1000 }} 1000w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image_alt | escape }}"
              loading="lazy"
            >
          </div>
        {%- else -%}
          <div class="media media--portrait">
            <div class="placeholder-media">{{ 'product-1' | placeholder_svg_tag }}</div>
          </div>
        {%- endif -%}
      </div>

      <div class="why__text reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte text-secondary">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="why__stats" role="list">
            {%- for block in section.blocks -%}
              <li class="why__stat" {{ block.shopify_attributes }}>
                <span class="why__stat-value">{{ block.settings.value }}</span>
                <span class="why__stat-label text-small text-secondary">{{ block.settings.label }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="button button--secondary why__button" href="{{ section.settings.button_link | default: '#bundle' }}">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  .why__grid {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .why__text > h2 {
    margin-bottom: 16px;
  }

  .why__stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 20px;
    margin: 28px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--color-border);
  }

  .why__stat {
    display: grid;
    gap: 2px;
  }

  .why__stat-value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .why__button {
    margin-top: 28px;
  }

  @media screen and (min-width: 750px) {
    .why__grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }

    .why__grid--reverse .why__media {
      order: 2;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Why encapsulated",
  "tag": "section",
  "class": "why-section",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Orbs of serum resting on a fingertip"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why orbs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sealed until the second you use it"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>PDRN is sensitive to air and light. In an open bottle it starts to lose its freshness from the first pump onward.</p><p>So we hold it differently. Each orb is a sealed dose, kept whole in the bottle until you press it between your fingers. Nothing oxidises on a shelf, and nothing is exposed until it is already on its way to your skin.</p><p>It is designed to give every application the same fresh dose as the first.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See the bundles"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "30,000ppm"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Hyaluronic PDRN"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why encapsulated",
      "blocks": [
        { "type": "stat", "settings": { "value": "30,000ppm", "label": "Hyaluronic PDRN" } },
        { "type": "stat", "settings": { "value": "One dose", "label": "Sealed per orb" } },
        { "type": "stat", "settings": { "value": "45g", "label": "About 8 weeks" } }
      ]
    }
  ]
}
{% endschema %}
