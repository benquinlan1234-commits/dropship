<div class="section main-404">
  <div class="page-width text-center">
    <p class="section__eyebrow main-404__eyebrow">404</p>
    <h1>{{ section.settings.heading | default: 'Page not found' }}</h1>
    <p class="text-secondary main-404__text">
      {{- section.settings.text | default: 'The page you were looking for does not exist.' -}}
    </p>
    <a class="button" href="{{ routes.root_url }}">
      {{- section.settings.button_label | default: 'Back to the shop' -}}
    </a>
  </div>
</div>

{% style %}
  .main-404 {
    padding-block: calc(var(--section-padding-desktop) * 1.2);
  }

  .main-404__eyebrow {
    justify-content: center;
  }

  .main-404__eyebrow::before,
  .main-404__eyebrow::after {
    content: '';
    width: 32px;
    height: 1px;
    background-color: var(--color-silver);
  }

  .main-404__text {
    max-width: 42ch;
    margin-inline: auto;
    margin-bottom: 32px;
  }
{% endstyle %}

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The page you were looking for does not exist."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Back to the shop" }
  ]
}
{% endschema %}
