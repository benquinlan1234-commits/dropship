<p class="eyebrow password__eyebrow">{{ settings.brand_name | default: shop.name }}</p>
<h1>{{ section.settings.heading | default: 'Opening soon' }}</h1>

{%- if section.settings.text != blank -%}
  <p class="text-secondary password__text">{{ section.settings.text }}</p>
{%- endif -%}

{%- form 'storefront_password', class: 'password__form' -%}
  {%- if form.errors -%}
    <p class="form-error text-small">{{ 'general.password.login_form_error' | t }}</p>
  {%- endif -%}
  <label class="visually-hidden" for="PasswordInput">{{ 'general.password.login_form_password_label' | t }}</label>
  <input
    class="search-form__input"
    id="PasswordInput"
    type="password"
    name="password"
    autocomplete="current-password"
    placeholder="{{ 'general.password.login_form_password_label' | t }}"
  >
  <button class="button button--small" type="submit">{{ 'general.password.login_password_button' | t }}</button>
{%- endform -%}

<p class="text-small text-secondary password__admin">{{ 'general.password.admin_link_html' | t }}</p>

{% style %}
  .password {
    padding-block: calc(var(--section-padding-desktop) * 1.4);
  }

  .password__eyebrow {
    justify-content: center;
  }

  .password__text {
    max-width: 44ch;
    margin-inline: auto;
    margin-bottom: 32px;
  }

  .password__form {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .password__admin {
    margin-top: 32px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We are putting the finishing touches on the shop. Check back shortly."
    }
  ]
}
{% endschema %}
