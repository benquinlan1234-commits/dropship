{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar"
    style="--announcement-bg: {{ section.settings.background }}; --announcement-color: {{ section.settings.text_color }};"
  >
    <div class="page-width announcement-bar__inner">
      {%- for block in section.blocks -%}
        <p class="announcement-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>

  {% style %}
    .announcement-bar {
      background-color: var(--announcement-bg);
      color: var(--announcement-color);
      font-size: 0.6875rem;
      font-weight: 500;
      font-variant-caps: all-small-caps;
      letter-spacing: 0.15em;
    }

    .announcement-bar__inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 52px;
      min-height: 42px;
      text-align: center;
    }

    .announcement-bar__item {
      margin: 0;
    }

    .announcement-bar__item + .announcement-bar__item {
      display: none;
    }

    @media screen and (min-width: 990px) {
      .announcement-bar__item + .announcement-bar__item {
        display: block;
      }
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#2A2340"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#EFE9F7"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over $44.70"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free shipping over $44.70" } },
        { "type": "announcement", "settings": { "text": "30-day money-back guarantee" } },
        { "type": "announcement", "settings": { "text": "Ships in 7–11 days" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
