{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0
  assign threshold_money = threshold | times: 100 | money_without_trailing_zeros
-%}

<div class="section section--tight guarantee{% if section.settings.show_divider %} section--bordered{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header section__header--center">
        <h2 class="guarantee__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <ul class="guarantee__items grid grid--3" role="list">
      {%- for block in section.blocks -%}
        <li class="guarantee__item reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="icon-ring guarantee__icon">
              {% render 'icon', icon: block.settings.icon, size: 'lg' %}
            </span>
          {%- endif -%}

          <div>
            <h3 class="guarantee__title">
              {{- block.settings.title | replace: '[threshold]', threshold_money -}}
            </h3>
            {%- if block.settings.text != blank -%}
              <p class="text-secondary text-small guarantee__text">
                {{- block.settings.text | replace: '[threshold]', threshold_money -}}
              </p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% style %}
  .guarantee__heading {
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    margin-bottom: 0;
  }

  .guarantee__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .guarantee__item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .guarantee__icon {
    width: 46px;
    height: 46px;
  }

  .guarantee__icon .icon {
    width: 20px;
    height: 20px;
  }

  .guarantee__title {
    margin: 0 0 4px;
    font-size: 0.9375rem;
  }

  .guarantee__text {
    margin: 0;
    max-width: 32ch;
  }

  @media screen and (min-width: 750px) {
    .guarantee__items {
      gap: 40px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Guarantee strip",
  "tag": "section",
  "class": "guarantee-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Type [threshold] in any title or text to insert the free shipping threshold from Theme settings."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "truck", "label": "Truck" },
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30-day money-back guarantee"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Not right for your skin? Email us within 30 days for a refund."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "30-day money-back guarantee",
            "text": "Not right for your skin? Email us within 30 days for a refund."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "text": "Payments are handled by Shopify. We never see your card details."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping over [threshold]",
            "text": "Tracked delivery in 7–11 days, wherever you are."
          }
        }
      ]
    }
  ]
}
{% endschema %}
