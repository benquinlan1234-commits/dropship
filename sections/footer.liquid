{%- assign brand = settings.brand_name | default: shop.name -%}

<footer class="footer section--deep" role="contentinfo">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__wordmark">{{ brand }}</p>
        {%- if section.settings.tagline != blank -%}
          <p class="text-small footer__body footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__list" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'text' -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <div class="rte text-small footer__body">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="text-small footer__body">
        {{ 'sections.footer.copyright_html' | t: year: 'now' | date: '%Y', brand: brand }}
      </p>

      <ul class="footer__social" role="list">
        {%- if settings.social_instagram_link != blank -%}
          <li>
            <a href="{{ settings.social_instagram_link }}">{{ 'sections.footer.social_instagram' | t }}</a>
          </li>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <li><a href="{{ settings.social_tiktok_link }}">{{ 'sections.footer.social_tiktok' | t }}</a></li>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <li><a href="{{ settings.social_youtube_link }}">{{ 'sections.footer.social_youtube' | t }}</a></li>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <li><a href="{{ settings.social_facebook_link }}">{{ 'sections.footer.social_facebook' | t }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</footer>

{% style %}
  .footer {
    margin-top: 0;
    padding-block: 64px 28px;
  }

  .footer__top {
    display: grid;
    gap: 32px;
    padding-bottom: 40px;
  }

  /* A letter-spaced serif logo, which is most of the brand's presence here. */
  .footer__wordmark {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-optical-sizing: auto;
    font-size: 1.5rem;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: var(--color-on-deep);
  }

  .footer__body {
    color: rgba(239, 233, 247, 0.72);
  }

  .footer__tagline {
    max-width: 30ch;
  }

  .footer__heading {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.15em;
    color: rgba(239, 233, 247, 0.6);
  }

  .footer__list,
  .footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.875rem;
  }

  .footer__list a,
  .footer__social a {
    color: var(--color-accent-on-deep);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .footer__list a:hover,
  .footer__social a:hover {
    color: var(--color-on-deep);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid transparent;
    border-image: var(--silver-line) 1;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__social {
    grid-auto-flow: column;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      padding-block: 96px 28px;
    }

    .footer__top {
      grid-template-columns: 1.5fr repeat(auto-fit, minmax(150px, 1fr));
      gap: 48px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Minimal skincare, made for sensitive routines."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Help"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Questions? Email us and we will reply within one business day.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [{ "type": "menu" }, { "type": "text" }]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
