[
  {
    "name": "theme_info",
    "theme_name": "PDRN Orb Serum",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Orb",
        "info": "Used in the header when no logo is uploaded, and in the page title."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "default": 110
      },
      {
        "type": "text",
        "id": "logo_alt",
        "label": "Logo alt text",
        "default": "Orb"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 96 x 96 px."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Pearl, lilac and plum with a single violet accent. Every value here is measured for AA contrast at the defaults — if you change them, re-check text against its background."
      },
      {
        "type": "header",
        "content": "Light surfaces"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page",
        "default": "#F1ECF7",
        "info": "Lilac-pearl. Deliberately not white."
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card",
        "default": "#FAF8FD",
        "info": "Pearl. Cards, drawers and inputs."
      },
      {
        "type": "color",
        "id": "color_pearl",
        "label": "Media",
        "default": "#E7DFF2",
        "info": "Behind images and placeholder blocks."
      },
      {
        "type": "header",
        "content": "Dark surfaces"
      },
      {
        "type": "color",
        "id": "color_deep",
        "label": "Plum",
        "default": "#2A2340",
        "info": "The clinic section, footer and announcement bar."
      },
      {
        "type": "color",
        "id": "color_on_deep",
        "label": "Text on plum",
        "default": "#EFE9F7"
      },
      {
        "type": "color",
        "id": "color_accent_on_deep",
        "label": "Accent on plum",
        "default": "#BCA9EC",
        "info": "Links and highlights inside dark sections. A light violet, because the main accent is unreadable on plum."
      },
      {
        "type": "header",
        "content": "Ink"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text — primary",
        "default": "#2A2340"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Text — secondary",
        "default": "#5C5470"
      },
      {
        "type": "header",
        "content": "Accent and lines"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#6E5AAB",
        "info": "Buttons, eyebrows, selected states. Keep it dark enough for white button text (at least 4.5:1)."
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_accent_ink",
        "label": "Accent — text",
        "default": "#635099",
        "info": "Violet text such as eyebrows and per-bottle prices. A shade darker than the accent so it still passes AA on the tinted pearl and lilac fills."
      },
      {
        "type": "color",
        "id": "color_accent_soft",
        "label": "Accent — soft",
        "default": "#E3D9F5",
        "info": "Tints behind selected cards and badges."
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Hairline",
        "default": "#D6CEE4"
      },
      {
        "type": "color",
        "id": "color_silver",
        "label": "Silver",
        "default": "#C6C0D2",
        "info": "Rules, icon rings and tags. Decorative only."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Two families: a serif for display and numbers, a sans for body and UI. The contrast between them is what stops the page reading as a template."
      },
      {
        "type": "checkbox",
        "id": "use_google_font",
        "label": "Load fonts from Google Fonts",
        "default": true
      },
      {
        "type": "text",
        "id": "display_font_family",
        "label": "Display font",
        "default": "Fraunces",
        "info": "Headings, numerals and prices. Loaded as a variable font where one exists."
      },
      {
        "type": "text",
        "id": "body_font_family",
        "label": "Body font",
        "default": "Manrope",
        "info": "Body copy, buttons and UI."
      },
      {
        "type": "text",
        "id": "display_font_fallback",
        "label": "Display fallback stack",
        "default": "Georgia, 'Times New Roman', serif"
      },
      {
        "type": "text",
        "id": "font_fallback_stack",
        "label": "Body fallback stack",
        "default": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 17
      },
      {
        "type": "select",
        "id": "heading_weight",
        "label": "Display weight",
        "options": [
          {
            "value": "300",
            "label": "Light"
          },
          {
            "value": "400",
            "label": "Regular"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semibold"
          }
        ],
        "default": "400"
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "label": "Display letter spacing",
        "min": -30,
        "max": 10,
        "step": 1,
        "unit": "/1000em",
        "default": -10
      },
      {
        "type": "range",
        "id": "display_softness",
        "label": "Display softness",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 30,
        "info": "Fraunces' SOFT axis — rounds the terminals. No effect on fonts without that axis."
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Card radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 18
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "product",
        "id": "hero_product",
        "label": "Featured product",
        "info": "Every section on the home page reads its price and variants from this product."
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency code with prices",
        "default": false,
        "info": "For example $39.00 USD instead of $39.00."
      },
      {
        "type": "text",
        "id": "rating_value",
        "label": "Star rating",
        "default": "4.8",
        "info": "Shown next to the review count. Use a number between 0 and 5."
      },
      {
        "type": "text",
        "id": "review_count_text",
        "label": "Review count text",
        "default": "2,431 reviews"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": 35,
        "info": "In your store currency, without decimals. Used in the guarantee strip and cart drawer."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart drawer upsell product"
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Upsell heading",
        "default": "Add to your order"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note field",
        "default": false
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Reveal sections on scroll",
        "default": true,
        "info": "Always off for visitors who ask for reduced motion."
      },
      {
        "type": "checkbox",
        "id": "show_orb_glow",
        "label": "Show the drifting orb",
        "default": true,
        "info": "A large blurred violet orb behind the hero and offer. Drifts over 60 seconds; holds still under reduced motion."
      },
      {
        "type": "range",
        "id": "grain_opacity",
        "label": "Grain",
        "min": 0,
        "max": 6,
        "step": 1,
        "unit": "%",
        "default": 3,
        "info": "A fine noise texture over flat areas so they do not look digital."
      }
    ]
  }
]
