{%- comment -%}
  Small product card used by the collection, search and list-collections templates.

  Usage: {% render 'product-card', card_product: product %}
{%- endcomment -%}
<div class="product-card">
  <a class="product-card__link" href="{{ card_product.url }}">
    <div class="media media--portrait">
      {%- if card_product.featured_image -%}
        <img
          src="{{ card_product.featured_image | image_url: width: 600 }}"
          srcset="
            {{ card_product.featured_image | image_url: width: 300 }} 300w,
            {{ card_product.featured_image | image_url: width: 600 }} 600w
          "
          sizes="(min-width: 750px) 25vw, 50vw"
          width="{{ card_product.featured_image.width }}"
          height="{{ card_product.featured_image.height }}"
          alt="{{ card_product.featured_image.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="placeholder-media"></div>
      {%- endif -%}
    </div>

    <h3 class="product-card__title">{{ card_product.title }}</h3>
  </a>

  {% render 'product-price', product: card_product %}
</div>

{% style %}
  .product-card__link {
    display: block;
    text-decoration: none;
  }

  .product-card__title {
    margin: 16px 0 6px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
{% endstyle %}
