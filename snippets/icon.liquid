{%- comment -%}
  Inline SVG icon set.

  Usage: {% render 'icon', icon: 'star' %}
         {% render 'icon', icon: 'check', size: 'lg' %}

  Accepts: star, star-outline, check, shield, truck, lock, plus, minus, cart, close,
           chevron, arrow-right, arrow-down, leaf, drop, sparkle, play, pause
{%- endcomment -%}
{%- liquid
  assign classes = 'icon'
  if size == 'lg'
    assign classes = classes | append: ' icon--lg'
  endif
  if icon == 'star' or icon == 'cart'
    assign classes = classes | append: ' icon--filled'
  endif
  if extra_class
    assign classes = classes | append: ' ' | append: extra_class
  endif
-%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5l2.6 5.5 5.9.8-4.3 4.2 1 6-5.2-2.8L6.8 20l1-6L3.5 9.8l5.9-.8z"/></svg>
  {%- when 'star-outline' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5l2.6 5.5 5.9.8-4.3 4.2 1 6-5.2-2.8L6.8 20l1-6L3.5 9.8l5.9-.8z"/></svg>
  {%- when 'check' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 12.5l5 5 10-11"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l7 3v5.5c0 4.2-2.8 7.9-7 9.5-4.2-1.6-7-5.3-7-9.5V6z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 10h4l3 3v2.5h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'lock' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2"/><path d="M8 10.5V7.8a4 4 0 018 0v2.7"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'cart' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.4 7h13.1l-1.4 8.2a2 2 0 01-2 1.7H9.4a2 2 0 01-2-1.6L5.5 4.9H2.8v-1.4h3.9zM9.6 19.2a1.4 1.4 0 110 2.8 1.4 1.4 0 010-2.8zm7 0a1.4 1.4 0 110 2.8 1.4 1.4 0 010-2.8z"/></svg>
  {%- when 'close' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'chevron' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9.5l6 6 6-6"/></svg>
  {%- when 'arrow-down' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v16M6 14l6 6 6-6"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
  {%- when 'leaf' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 4c0 8-4.6 13-10.5 13A4.5 4.5 0 015 12.5C5 7 10.5 4 20 4z"/><path d="M4 20c3.5-4.5 7-7.5 12-10"/></svg>
  {%- when 'drop' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5c3.6 4.2 5.5 7.2 5.5 9.7a5.5 5.5 0 11-11 0c0-2.5 1.9-5.5 5.5-9.7z"/></svg>
  {%- when 'sparkle' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5l1.8 5.2 5.2 1.8-5.2 1.8L12 17.5l-1.8-5.2L5 10.5l5.2-1.8z"/><path d="M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg>
  {%- when 'play' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5l11 6.5-11 6.5z"/></svg>
  {%- when 'pause' -%}
    <svg class="{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5v14M15 5v14"/></svg>
{%- endcase -%}
